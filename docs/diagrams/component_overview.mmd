    %% ============================================================================
    %% RELATIONSHIPS & DATA FLOW
    %% ============================================================================

    %% App renders ExperienceShell
    App -->|renders| ExperienceShell

    %% App imports content for placeholder metadata
    ContentBarrel -.provides data.-> App

    %% ExperienceShell wraps sections
    ExperienceShell -->|wraps children| Sections

    %% Future components consume content
    ContentBarrel -.will provide data.-> Hero
    ContentBarrel -.will provide data.-> Simulation
    ContentBarrel -.will provide data.-> Features
    ContentBarrel -.will provide data.-> Integration

    %% Future components use contexts
    FeatureFlagCtx -.consumed by.-> Hero
    FeatureFlagCtx -.consumed by.-> Integration
    ScrollRevealCtx -.consumed by.-> Features
    ScrollRevealCtx -.consumed by.-> Simulation

    %% Future components use hooks
    Hero -.will use.-> ClipboardHook
    Integration -.will use.-> GitHubHook
    Features -.will use.-> ScrollHook

    %% Hooks emit analytics
    ClipboardHook -.emits events.-> AnalyticsUtil
    GitHubHook -.emits events.-> AnalyticsUtil

    %% Navigation bar consumes external links
    ContentBarrel -.provides links.-> NavBar

